<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform SplashScreen: minSdk 34 ≥ API 31 — the system reads the
         windowSplashScreen* attrs directly off the launched theme. Edge-to-edge
         is enforced at targetSdk 35+ and MainActivity calls enableEdgeToEdge(),
         so statusBarColor is intentionally absent (a no-op attr on this SDK). -->
    <style name="Theme.Slipstream" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
