<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false disables cloud backup, but on some OEM devices it does NOT
  disable device-to-device (D2D) transfer. The DataStore holds RPC/extension
  tokens, engine config and download history (absolute, device-specific paths)
  that must not migrate to another device, so exclude every domain from both
  cloud backup and D2D explicitly. minSdk 34 → only the Android 12+
  data-extraction-rules format is needed (no legacy fullBackupContent).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
